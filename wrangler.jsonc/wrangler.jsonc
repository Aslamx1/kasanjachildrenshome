{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kasanja-childrens-home",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kch-production",
      "database_id": "26d04097-e4ad-491f-99bb-5e2ac6575ee6"
    }
  ],
  "route": {
    "pattern": "kasanjachildrenhome.org/*",
    "zone_name": "kasanjachildrenhome.org"
  },
  "vars": {
    "NODE_ENV": "production",
    "JWT_EXPIRE": "7d"
  },
  "observability": {
    "enabled": true
  }
}
